{
  "schema_version": "edgeenv-regression-replay-fixture-matrix-v1",
  "owner": "edgeenv",
  "scope": "local-first runtime regression replay fixtures for downstream Runtime Intelligence handoff checks",
  "boundaries": {
    "not_a_deployment_decision": true,
    "not_a_guard_analysis": true,
    "not_production_monitoring": true,
    "comparability_first": true
  },
  "required_roles": [
    "same_condition_regression",
    "runtime_comparison_blocked",
    "target_comparison_blocked",
    "protocol_mismatch_blocked",
    "telemetry_gap_same_condition",
    "replay_sequence_context"
  ],
  "fixtures": [
    {
      "role": "same_condition_regression",
      "path": "edgeenv_same_condition_regression.json",
      "mode": "same-condition",
      "comparable": true,
      "regression_delta_allowed": true,
      "expected_regression_detected": true,
      "expected_recommendation": "review_required",
      "requires_runtime_telemetry_context": true,
      "requires_history_seed_run_config": true,
      "telemetry_gap_expected": false,
      "expected_triggered_thresholds": [
        "mean_latency_review",
        "p99_latency_high",
        "fps_drop_review",
        "memory_peak_warning"
      ]
    },
    {
      "role": "runtime_comparison_blocked",
      "path": "edgeenv_runtime_comparison_blocked.json",
      "mode": "runtime-comparison",
      "comparable": false,
      "regression_delta_allowed": false,
      "expected_regression_detected": false,
      "expected_recommendation": "review_as_runtime_comparison",
      "requires_runtime_telemetry_context": false,
      "requires_history_seed_run_config": false,
      "telemetry_gap_expected": false
    },
    {
      "role": "target_comparison_blocked",
      "path": "edgeenv_target_comparison_blocked.json",
      "mode": "target-comparison",
      "comparable": false,
      "regression_delta_allowed": false,
      "expected_regression_detected": false,
      "expected_recommendation": "review_as_target_comparison",
      "requires_runtime_telemetry_context": false,
      "requires_history_seed_run_config": false,
      "telemetry_gap_expected": false
    },
    {
      "role": "protocol_mismatch_blocked",
      "path": "edgeenv_protocol_mismatch_blocked.json",
      "mode": "protocol_mismatch",
      "comparable": false,
      "regression_delta_allowed": false,
      "expected_regression_detected": false,
      "expected_recommendation": "rerun_with_matching_protocol",
      "requires_runtime_telemetry_context": false,
      "requires_history_seed_run_config": false,
      "telemetry_gap_expected": false
    },
    {
      "role": "telemetry_gap_same_condition",
      "path": "edgeenv_candidate_telemetry_gap.json",
      "mode": "same-condition",
      "comparable": true,
      "regression_delta_allowed": true,
      "expected_regression_detected": false,
      "expected_recommendation": "no_action_required",
      "requires_runtime_telemetry_context": true,
      "requires_history_seed_run_config": false,
      "telemetry_gap_expected": true,
      "expected_evidence_gaps": [
        "runtime_telemetry_missing_in_result",
        "runtime_telemetry_missing"
      ]
    },
    {
      "role": "replay_sequence_context",
      "path": "edgeenv_sequence_inversion.json",
      "mode": "same-condition",
      "comparable": true,
      "regression_delta_allowed": true,
      "expected_regression_detected": false,
      "expected_recommendation": "no_action_required",
      "requires_runtime_telemetry_context": true,
      "requires_history_seed_run_config": false,
      "telemetry_gap_expected": false,
      "sequence_context": "inverted"
    }
  ]
}
